# ChrisTech unified stack
USE_SQLITE=true
SECRET_KEY=christech-secret-key-change-in-production
PORT=5000
FLASK_DEBUG=true
APP_URL=http://localhost:5000

# Optional PostgreSQL (set USE_SQLITE=false to use these)
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=christech_db
# DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/christech_db

# SMTP Email Alert Settings (leave blank to simulate in the terminal)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
ALERT_RECIPIENT_EMAIL=
