{
  "name": "jawabu-admin",
  "private": true,
  "version": "1.0.0",
  "description": "Sleek Sisters shop admin and POS",
  "author": "Sleek Sisters",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 5176 --host 127.0.0.1",
    "desktop": "electron .",
    "build": "vite build",
    "icon": "node scripts/make-icon.mjs",
    "dist:win": "npm run icon && vite build && electron-builder --win nsis portable --x64",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.2",
    "reaviz": "^16.2.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^38.8.6",
    "electron-builder": "^26.0.12",
    "jimp": "^1.6.1",
    "oxlint": "^1.75.0",
    "png-to-ico": "^3.0.2",
    "rcedit": "^5.0.2",
    "vite": "^8.2.0"
  },
  "build": {
    "appId": "com.sleeksisters.admin",
    "productName": "Sleek Sisters Admin",
    "copyright": "Sleek Sisters",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "afterPack": "./electron/afterPack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Sleek Sisters Admin",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "runAfterFinish": true
    }
  }
}
